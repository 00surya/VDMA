# Vertex AI: these OAuth credentials identify your app; sign in with scripts/google_login.py.
GOOGLE_CLIENT_ID=xxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxx
VMD_AI_ENABLED=true
VMD_AI_BACKEND=vertex
VMD_AI_VERTEX_PROJECT=your-google-cloud-project
VMD_AI_VERTEX_LOCATION=global
VMD_AI_FAST_MODEL=gemini-3.1-flash-lite
VMD_AI_QUALITY_MODEL=gemini-3.5-flash
# Live availability differs by Vertex project/region. Select an accessible Live model.
VMD_AI_LIVE_MODEL=gemini-3.8-live
VMD_AI_LIVE_LOCATION=global
VMD_GOOGLE_CREDENTIALS_FILE=data/google-credentials.json
# Explicit manual analysis is available. Enable for new incidents / dispatch following.
VMD_AI_AUTO_ANALYZE=true
VMD_AI_AUTO_FOLLOW=false
VMD_AI_HOURLY_LIMIT=60
# Only the separate voice gateway is exposed through this HTTPS origin.
VMD_VOICE_PUBLIC_URL=
VMD_VOICE_PORT=8769
# Keep incident for existing speech. gemini_live needs Twilio + a working voice gateway.
TWILIO_VOICE_MODE=incident

VMD_REPORT_BASE_URL=http://127.0.0.1:8765
